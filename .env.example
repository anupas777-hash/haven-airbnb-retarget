# Server
PORT=3001
DATABASE_URL="file:./prisma/dev.db"
NODE_ENV=development

# Google Sheets — leave empty for dry-run (public sheets work without creds)
# For private sheets: create a service account, share sheet with its email, paste JSON path or inline JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# WhatsApp Cloud API — leave empty for dry-run (ConsoleProvider simulates sends)
# Fill to go live (see README + /settings wizard)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=retarget_verify_token_change_me
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=reengagement_offer
WHATSAPP_TEMPLATE_LOCALE=en_US

# App
BRAND_NAME=
DEFAULT_DISCOUNT_PERCENT=10
ACCESS_GATE_TOKEN=
CORS_ORIGIN=http://localhost:5173

# Queue
QUEUE_CONCURRENCY=5
QUEUE_RATE_PER_SECOND=2
